<ui:FluentWindow x:Class="Pulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pulse"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Pulse" />
        <DataGrid Grid.Row="1"
                  x:Name="ProcessesGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process"
                                    Binding="{Binding Name}" />
                
                <DataGridTextColumn Header="PID"
                                    Binding="{Binding Id}" />
                
                <DataGridTextColumn Header="Memory"
                                    Binding="{Binding Memory}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</ui:FluentWindow>
