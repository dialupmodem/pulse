<Window x:Class="Pulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pulse"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="12">
        <DataGrid x:Name="ProcessesGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process"
                                    Binding="{Binding Name}" />
                
                <DataGridTextColumn Header="PID"
                                    Binding="{Binding Id}" />
                
                <DataGridTextColumn Header="Memory"
                                    Binding="{Binding Memory}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
